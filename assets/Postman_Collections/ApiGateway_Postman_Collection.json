{
  "info": {
    "_postman_id": "stayrate-api-gateway-comprehensive",
    "name": "StayRate - API Gateway (:8084)",
    "description": "Complete API Gateway collection containing AuthController and proxied endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "GATEWAY_URL",
      "value": "http://localhost:8084",
      "type": "string"
    },
    {
      "key": "BEARER_TOKEN",
      "value": "your_okta_jwt_token_here",
      "type": "string"
    },
    { "key": "userId", "value": "usr-101", "type": "string" },
    { "key": "hotelId", "value": "htl-202", "type": "string" },
    { "key": "ratingId", "value": "rtg-303", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth - Get Login Info & Tokens (AuthController)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
        ],
        "url": {
          "raw": "{{GATEWAY_URL}}/auth/login",
          "host": ["{{GATEWAY_URL}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "[Gateway Route] Create User",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"userId\": \"{{userId}}\",\n    \"name\": \"Shivani Dubey\",\n    \"email\": \"shivani@example.com\",\n    \"about\": \"Software Engineer\"\n}"
        },
        "url": {
          "raw": "{{GATEWAY_URL}}/users",
          "host": ["{{GATEWAY_URL}}"],
          "path": ["users"]
        }
      }
    },
    {
      "name": "[Gateway Route] Get User Details (Aggregated)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
        ],
        "url": {
          "raw": "{{GATEWAY_URL}}/users/{{userId}}",
          "host": ["{{GATEWAY_URL}}"],
          "path": ["users", "{{userId}}"]
        }
      }
    },
    {
      "name": "[Gateway Route] Get All Hotels",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
        ],
        "url": {
          "raw": "{{GATEWAY_URL}}/hotels",
          "host": ["{{GATEWAY_URL}}"],
          "path": ["hotels"]
        }
      }
    },
    {
      "name": "[Gateway Route] Get Staff List",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
        ],
        "url": {
          "raw": "{{GATEWAY_URL}}/staffs",
          "host": ["{{GATEWAY_URL}}"],
          "path": ["staffs"]
        }
      }
    },
    {
      "name": "[Gateway Route] Get All Ratings",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
        ],
        "url": {
          "raw": "{{GATEWAY_URL}}/ratings",
          "host": ["{{GATEWAY_URL}}"],
          "path": ["ratings"]
        }
      }
    }
  ]
}
