{
  "info": {
    "_postman_id": "stayrate-master-platform-comprehensive",
    "name": "StayRate Microservices Platform - Master Collection",
    "description": "Master collection combining all services, direct microservice operations, gateway routing, and circuit breaker tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "GATEWAY_URL",
      "value": "http://localhost:8084",
      "type": "string"
    },
    {
      "key": "USER_SERVICE_URL",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "HOTEL_SERVICE_URL",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "RATING_SERVICE_URL",
      "value": "http://localhost:8083",
      "type": "string"
    },
    {
      "key": "BEARER_TOKEN",
      "value": "your_okta_jwt_token_here",
      "type": "string"
    },
    { "key": "userId", "value": "usr-101", "type": "string" },
    { "key": "hotelId", "value": "htl-202", "type": "string" },
    { "key": "ratingId", "value": "rtg-303", "type": "string" }
  ],
  "item": [
    {
      "name": "00. Security & Auth",
      "item": [
        {
          "name": "Auth - Get Login Info / Token Status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
            ],
            "url": {
              "raw": "{{GATEWAY_URL}}/auth/login",
              "host": ["{{GATEWAY_URL}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "01. Direct User Service (:8081)",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"userId\": \"{{userId}}\",\n    \"name\": \"Shivani Dubey\",\n    \"email\": \"shivani@example.com\",\n    \"about\": \"Software Engineer\"\n}"
            },
            "url": {
              "raw": "{{USER_SERVICE_URL}}/users",
              "host": ["{{USER_SERVICE_URL}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
            ],
            "url": {
              "raw": "{{USER_SERVICE_URL}}/users/{{userId}}",
              "host": ["{{USER_SERVICE_URL}}"],
              "path": ["users", "{{userId}}"]
            }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Shivani (Updated)\",\n    \"email\": \"updated@example.com\",\n    \"about\": \"Lead Dev\"\n}"
            },
            "url": {
              "raw": "{{USER_SERVICE_URL}}/users/{{userId}}",
              "host": ["{{USER_SERVICE_URL}}"],
              "path": ["users", "{{userId}}"]
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
            ],
            "url": {
              "raw": "{{USER_SERVICE_URL}}/users/{{userId}}",
              "host": ["{{USER_SERVICE_URL}}"],
              "path": ["users", "{{userId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "02. Direct Hotel Service (:8082)",
      "item": [
        {
          "name": "Create Hotel",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"id\": \"{{hotelId}}\",\n    \"name\": \"Grand Palace Resort\",\n    \"location\": \"Mumbai\",\n    \"about\": \"Luxury hotel\"\n}"
            },
            "url": {
              "raw": "{{HOTEL_SERVICE_URL}}/hotels",
              "host": ["{{HOTEL_SERVICE_URL}}"],
              "path": ["hotels"]
            }
          }
        },
        {
          "name": "Get Hotel By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
            ],
            "url": {
              "raw": "{{HOTEL_SERVICE_URL}}/hotels/{{hotelId}}",
              "host": ["{{HOTEL_SERVICE_URL}}"],
              "path": ["hotels", "{{hotelId}}"]
            }
          }
        },
        {
          "name": "Update Hotel",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Grand Palace Resort & Spa\",\n    \"location\": \"Mumbai\",\n    \"about\": \"Updated description\"\n}"
            },
            "url": {
              "raw": "{{HOTEL_SERVICE_URL}}/hotels/{{hotelId}}",
              "host": ["{{HOTEL_SERVICE_URL}}"],
              "path": ["hotels", "{{hotelId}}"]
            }
          }
        },
        {
          "name": "Delete Hotel",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
            ],
            "url": {
              "raw": "{{HOTEL_SERVICE_URL}}/hotels/{{hotelId}}",
              "host": ["{{HOTEL_SERVICE_URL}}"],
              "path": ["hotels", "{{hotelId}}"]
            }
          }
        },
        {
          "name": "Get Staff List",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
            ],
            "url": {
              "raw": "{{HOTEL_SERVICE_URL}}/staffs",
              "host": ["{{HOTEL_SERVICE_URL}}"],
              "path": ["staffs"]
            }
          }
        }
      ]
    },
    {
      "name": "03. Direct Rating Service (:8083)",
      "item": [
        {
          "name": "Create Rating",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"ratingId\": \"{{ratingId}}\",\n    \"userId\": \"{{userId}}\",\n    \"hotelId\": \"{{hotelId}}\",\n    \"rating\": 5,\n    \"feedback\": \"Great!\"\n}"
            },
            "url": {
              "raw": "{{RATING_SERVICE_URL}}/ratings",
              "host": ["{{RATING_SERVICE_URL}}"],
              "path": ["ratings"]
            }
          }
        },
        {
          "name": "Get All Ratings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
            ],
            "url": {
              "raw": "{{RATING_SERVICE_URL}}/ratings",
              "host": ["{{RATING_SERVICE_URL}}"],
              "path": ["ratings"]
            }
          }
        },
        {
          "name": "Get Single Rating By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
            ],
            "url": {
              "raw": "{{RATING_SERVICE_URL}}/ratings/{{ratingId}}",
              "host": ["{{RATING_SERVICE_URL}}"],
              "path": ["ratings", "{{ratingId}}"]
            }
          }
        },
        {
          "name": "Get Ratings By User ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
            ],
            "url": {
              "raw": "{{RATING_SERVICE_URL}}/ratings/users/{{userId}}",
              "host": ["{{RATING_SERVICE_URL}}"],
              "path": ["ratings", "users", "{{userId}}"]
            }
          }
        },
        {
          "name": "Get Ratings By Hotel ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
            ],
            "url": {
              "raw": "{{RATING_SERVICE_URL}}/ratings/hotels/{{hotelId}}",
              "host": ["{{RATING_SERVICE_URL}}"],
              "path": ["ratings", "hotels", "{{hotelId}}"]
            }
          }
        },
        {
          "name": "Update Rating",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"rating\": 4,\n    \"feedback\": \"Updated feedback\"\n}"
            },
            "url": {
              "raw": "{{RATING_SERVICE_URL}}/ratings/{{ratingId}}",
              "host": ["{{RATING_SERVICE_URL}}"],
              "path": ["ratings", "{{ratingId}}"]
            }
          }
        },
        {
          "name": "Delete Rating",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
            ],
            "url": {
              "raw": "{{RATING_SERVICE_URL}}/ratings/{{ratingId}}",
              "host": ["{{RATING_SERVICE_URL}}"],
              "path": ["ratings", "{{ratingId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "04. Gateway End-To-End & Routing",
      "item": [
        {
          "name": "[Gateway] Get User Details (Aggregated)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
            ],
            "url": {
              "raw": "{{GATEWAY_URL}}/users/{{userId}}",
              "host": ["{{GATEWAY_URL}}"],
              "path": ["users", "{{userId}}"]
            }
          }
        },
        {
          "name": "[Gateway] Get All Hotels",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
            ],
            "url": {
              "raw": "{{GATEWAY_URL}}/hotels",
              "host": ["{{GATEWAY_URL}}"],
              "path": ["hotels"]
            }
          }
        },
        {
          "name": "[Gateway] Get Staff List",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
            ],
            "url": {
              "raw": "{{GATEWAY_URL}}/staffs",
              "host": ["{{GATEWAY_URL}}"],
              "path": ["staffs"]
            }
          }
        },
        {
          "name": "[Gateway] Get All Ratings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
            ],
            "url": {
              "raw": "{{GATEWAY_URL}}/ratings",
              "host": ["{{GATEWAY_URL}}"],
              "path": ["ratings"]
            }
          }
        },
        {
          "name": "[Resilience4j Fallback Test] Get User with Downstream Outage",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
            ],
            "url": {
              "raw": "{{GATEWAY_URL}}/users/{{userId}}",
              "host": ["{{GATEWAY_URL}}"],
              "path": ["users", "{{userId}}"]
            },
            "description": "Run this after shutting down HotelService or RatingService to trigger the ratingHotelFallback method inside UserController."
          }
        }
      ]
    }
  ]
}
