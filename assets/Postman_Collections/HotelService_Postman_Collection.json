{
  "info": {
    "_postman_id": "stayrate-hotel-service-comprehensive",
    "name": "StayRate - Hotel Service (:8082)",
    "description": "Complete collection for HotelController CRUD and StaffController endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "HOTEL_SERVICE_URL",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "BEARER_TOKEN",
      "value": "your_okta_jwt_token_here",
      "type": "string"
    },
    { "key": "hotelId", "value": "htl-202", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Create Hotel (Admin Authority)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"id\": \"{{hotelId}}\",\n    \"name\": \"Grand Palace Resort\",\n    \"location\": \"Mumbai, India\",\n    \"about\": \"Luxury 5-star hotel facing the Arabian Sea.\"\n}"
        },
        "url": {
          "raw": "{{HOTEL_SERVICE_URL}}/hotels",
          "host": ["{{HOTEL_SERVICE_URL}}"],
          "path": ["hotels"]
        }
      }
    },
    {
      "name": "2. Get Single Hotel By ID",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
        ],
        "url": {
          "raw": "{{HOTEL_SERVICE_URL}}/hotels/{{hotelId}}",
          "host": ["{{HOTEL_SERVICE_URL}}"],
          "path": ["hotels", "{{hotelId}}"]
        }
      }
    },
    {
      "name": "3. Get All Hotels",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
        ],
        "url": {
          "raw": "{{HOTEL_SERVICE_URL}}/hotels",
          "host": ["{{HOTEL_SERVICE_URL}}"],
          "path": ["hotels"]
        }
      }
    },
    {
      "name": "4. Update Hotel",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Grand Palace Resort & Spa\",\n    \"location\": \"Mumbai, India\",\n    \"about\": \"Updated description\"\n}"
        },
        "url": {
          "raw": "{{HOTEL_SERVICE_URL}}/hotels/{{hotelId}}",
          "host": ["{{HOTEL_SERVICE_URL}}"],
          "path": ["hotels", "{{hotelId}}"]
        }
      }
    },
    {
      "name": "5. Delete Hotel",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
        ],
        "url": {
          "raw": "{{HOTEL_SERVICE_URL}}/hotels/{{hotelId}}",
          "host": ["{{HOTEL_SERVICE_URL}}"],
          "path": ["hotels", "{{hotelId}}"]
        }
      }
    },
    {
      "name": "6. Get Staff List",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{BEARER_TOKEN}}" }
        ],
        "url": {
          "raw": "{{HOTEL_SERVICE_URL}}/staffs",
          "host": ["{{HOTEL_SERVICE_URL}}"],
          "path": ["staffs"]
        }
      }
    }
  ]
}
